# ==============================================================================
# Nugaom AI Pick — Production Go-Live Environment Template (.env.production)
# ==============================================================================
# วิธีใช้งาน:
# 1. รันคำสั่ง `node scripts/generate-golive-env.mjs` เพื่อสุ่มคีย์ความปลอดภัย 64 ตัวอักษร 4 ชุด
# 2. คัดลอกไฟล์นี้เป็น `.env.production` (หรือตั้งค่าใน Cloudflare / VPS Environment Variables)
# 3. กรอกค่าจริงในแต่ละหมวดด้านล่างให้ครบถ้วน
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. โดเมนจริง & LINE Login (บังคับใช้ HTTPS และ Callback ต้องตรงกับโดเมน)
# ------------------------------------------------------------------------------
APP_ORIGIN=https://nugaom.com
LINE_REDIRECT_URI=https://nugaom.com/api/auth/line/callback
LINE_CHANNEL_ID=YOUR_LINE_LOGIN_CHANNEL_ID
LINE_CHANNEL_SECRET=YOUR_LINE_LOGIN_CHANNEL_SECRET

# LINE User ID ของแอดมิน (ขึ้นต้นด้วย U ตามด้วยเลขฐานสิบหก 32 ตัว คั่นด้วยลูกน้ำได้หากมีหลายคน)
ADMIN_LINE_IDS=U0123456789abcdef0123456789abcdef

# เปิดให้สมาชิกใหม่ที่ล็อกอิน LINE รับสิทธิ์ทดลองใช้ฟรี 14 วันอัตโนมัติ
TRIAL_ENROLLMENT_ENABLED=true

# ปิดโหมด Demo Login ในหน้า Production จริง
ENABLE_DEMO_LOGIN=false
LAUNCH_MAINTENANCE=false

# ------------------------------------------------------------------------------
# 2. คีย์ความปลอดภัย 4 ชุด (ต้องยาว >= 32 ตัวอักษร และห้ามซ้ำกันเด็ดขาด)
# รัน `node scripts/generate-golive-env.mjs` เพื่อสร้างคีย์ชุดใหม่ทันที
# ------------------------------------------------------------------------------
SESSION_SECRET=REPLACE_WITH_64_HEX_FROM_GENERATE_SCRIPT_1
PORTFOLIO_HASH_SECRET=REPLACE_WITH_64_HEX_FROM_GENERATE_SCRIPT_2
AUTO_PICK_RUN_SECRET=REPLACE_WITH_64_HEX_FROM_GENERATE_SCRIPT_3

# คีย์เข้ารหัสไฟล์สำรองฐานข้อมูล (ต้องเป็นเลขฐานสิบหก 64 ตัวอักษรพอดี: /^[a-f0-9]{64}$/i)
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_FROM_GENERATE_SCRIPT_4
BACKUP_RECOVERY_CONFIRMED=true

# ------------------------------------------------------------------------------
# 3. ระบบชำระเงินอัตโนมัติ Stripe Billing (แพ็กเกจรายเดือน THB)
#    - BASIC (Starter): 159 บาท/เดือน (15900 สตางค์) -> AI 10 คำถาม/วัน
#    - PRO VIP (Pro):   399 บาท/เดือน (39900 สตางค์) -> AI 50 คำถาม/วัน
#    - Ultimate:        599 บาท/เดือน (59900 สตางค์) -> AI 150 คำถาม/วัน
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SECRET
STRIPE_PRICE_STARTER_MONTHLY=price_YOUR_159_THB_MONTHLY_PRICE_ID
STRIPE_PRICE_PRO_MONTHLY=price_YOUR_399_THB_MONTHLY_PRICE_ID
STRIPE_PRICE_ULTIMATE_MONTHLY=price_YOUR_599_THB_MONTHLY_PRICE_ID
STRIPE_PORTAL_CONFIGURATION_ID=bpc_YOUR_STRIPE_PORTAL_CONFIG_ID

# ------------------------------------------------------------------------------
# 4. บอทแจ้งเตือน Telegram VIP & แจ้งเตือนลูกค้าขอเปิดพอร์ต (บล.พาย 003 / ทรีนีตี้ 022)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_VIP_OR_ADMIN_CHAT_ID

# ------------------------------------------------------------------------------
# 5. ฐานข้อมูลถาวร & API ข้อมูลตลาด / น้องนักออม AI
# ------------------------------------------------------------------------------
# เลือก 'sqlite' (สำหรับเซิร์ฟเวอร์ถาวร/VPS) หรือ 'd1' (สำหรับ Cloudflare D1)
STORAGE_PROVIDER=sqlite
DATABASE_PATH=/var/lib/nugaom/market-signal.sqlite
AUTO_PICK_PERSISTENT_SERVER_CONFIRMED=true

# คีย์ AI สำหรับน้องนักออม AI Assistant (OpenAI API)
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY

# คีย์ข้อมูลตลาดหุ้นสหรัฐฯ / หุ้นไทย / ข่าว (ใส่เฉพาะแหล่งที่ใช้งานจริง)
FMP_API_KEY=YOUR_FMP_API_KEY
FINNHUB_API_KEY=YOUR_FINNHUB_API_KEY
SETTRADE_APP_ID=YOUR_SETTRADE_OPEN_API_APP_ID
SETTRADE_APP_SECRET=YOUR_SETTRADE_OPEN_API_APP_SECRET

