# Hostinger Node.js preview: select Node 24, Next.js, npm run build, .next.
# Set APP_ORIGIN to the HTTPS preview URL assigned by hPanel.
NODE_ENV=production
APP_ORIGIN=
FOREX_MT5_ENABLED=false
FOREX_MT5_LOCAL_MODE=false
FOREX_MT5_LOCAL_FILES_PATH=
FOREX_MT5_PERSISTENT_STORAGE=false
# Do not enable MT5 ingestion until stable private storage and LINE login are verified.
