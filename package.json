{
  "name": "nugaom-ai-pick",
  "private": true,
  "type": "module",
  "scripts": {
    "scanner:build": "node scripts/build-vps-scanner.mjs",
    "scanner:vps": "node scripts/vps-signal-worker.mjs",
    "cloud:deploy:bridge": "wrangler deploy --config deploy/cloudflare/wrangler.scanner-bridge.jsonc",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "cloud:build": "node scripts/cloud-build.mjs",
    "cloud:deploy:web": "wrangler deploy --config deploy/cloudflare/wrangler.vps-proxy.jsonc",
    "cloud:deploy:scanner": "wrangler deploy --config deploy/cloudflare/wrangler.scanner.jsonc",
    "cloud:secrets:web": "node --env-file=.env.local scripts/cloud-secrets.mjs web",
    "cloud:secrets:scanner": "node --env-file=.env.local scripts/cloud-secrets.mjs scanner",
    "cloud:check": "node scripts/cloud-check.mjs",
    "probe:settrade": "node scripts/probe-settrade.mjs",
    "probe:binance-spot": "node scripts/probe-binance-spot.mjs",
    "probe:forex": "node scripts/probe-forex.mjs",
    "probe:webull": "node --env-file=.env.local scripts/probe-webull.mjs",
    "probe:webull-stream": "node --env-file=.env.local scripts/probe-webull.mjs stream",
    "scan:webull-lab": "node --env-file=.env.local scripts/scan-webull.mjs",
    "universe:us": "node --env-file=.env.local scripts/build-us-universe.mjs",
    "universe:etfs": "node --env-file=.env.local scripts/build-us-etfs.mjs",
    "autopick:worker": "node --env-file=.env.local scripts/signal-worker.mjs",
    "autopick:legacy-worker": "node --env-file=.env.local scripts/auto-pick-worker.mjs",
    "signals:worker": "node --env-file=.env.local scripts/signal-worker.mjs",
    "test:signals": "node --test src/signals/*.test.mjs",
    "probe:signals": "node --env-file=.env.local scripts/probe-signals.mjs",
    "probe:autopick": "node --env-file=.env.local scripts/probe-auto-pick.mjs",
    "test:market-data": "node --test src/market-data/*.test.mjs",
    "backup:database": "node --env-file=.env.local scripts/backup-database.mjs",
    "check:production": "node --env-file=.env.local scripts/production-preflight.mjs",
    "check:prelaunch": "node scripts/prelaunch-smoke.mjs",
    "check:swing-data": "node scripts/check-swing-data.mjs",
    "export:swing-csv": "node --env-file=.env.local scripts/export-swing-csv.mjs",
    "test:swing": "node --test src/analysis/swing-standard.test.mjs src/backtest/*.test.mjs",
    "backtest:swing": "node scripts/replay-swing.mjs",
    "backtest:refresh": "node --env-file=.env.local scripts/refresh-backtest-summaries.mjs",
    "d1:schema:local": "wrangler d1 migrations apply DB --config deploy/cloudflare/wrangler.local.jsonc --local",
    "d1:schema:remote": "wrangler d1 migrations apply DB --config deploy/cloudflare/wrangler.remote.jsonc --remote",
    "d1:prepare": "node --env-file=.env.local scripts/d1-migrate.mjs prepare",
    "d1:import": "node --env-file=.env.local scripts/d1-migrate.mjs import deploy/cloudflare/wrangler.remote.jsonc",
    "d1:verify": "node --env-file=.env.local scripts/d1-migrate.mjs verify deploy/cloudflare/wrangler.remote.jsonc",
    "d1:unchanged": "node --env-file=.env.local scripts/d1-migrate.mjs unchanged",
    "test": "node scripts/test.mjs",
    "cloud:deploy:web:legacy": "wrangler deploy --config wrangler.jsonc",
    "cloud:deploy:web-data": "wrangler deploy --config deploy/cloudflare/wrangler.web-data.jsonc"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.9",
    "fast-xml-parser": "5.11.2",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.48.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stripe": "23.0.0",
    "three": "0.186.1",
    "wrangler": "4.147.0",
    "yahoo-finance2": "^4.0.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "overrides": {
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  },
  "devDependencies": {
    "esbuild": "0.28.1"
  }
}
