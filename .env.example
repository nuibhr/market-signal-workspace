# Local SET / DR read-only market data. Keep values in .env.local, never in Git.
SETTRADE_BROKER_ID=
SETTRADE_APP_CODE=
BROKER_APP_ID=
BROKER_API_SECRET=

# The production API stays closed until public display rights are confirmed.
SETTRADE_DISPLAY_RIGHTS_CONFIRMED=false

# TFEX Open API. Quote display remains closed in production until rights are confirmed.
TFEX_BROKER_ID=
TFEX_APP_CODE=
TFEX_APP_ID=
TFEX_APP_SECRET=
TFEX_DISPLAY_RIGHTS_CONFIRMED=false

# LINE Login channel. Register https://your-domain/api/auth/line/callback in LINE Developers.
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_REDIRECT_URI=http://localhost:3000/api/auth/line/callback

# Long random secrets, each at least 32 characters. Never commit real values.
SESSION_SECRET=
PORTFOLIO_HASH_SECRET=

# Local persistent SQLite path. Use a persistent Node host and backed-up volume.
DATABASE_PATH=./data/nugaom.sqlite

# Comma-separated LINE user IDs permitted to review portfolios and membership.
ADMIN_LINE_IDS=

# MarketDX theme news. Keep API key on server only. Public display requires confirmed rights.
MARKETDX_API_KEY=
MARKETDX_PUBLIC_DISPLAY_RIGHTS_CONFIRMED=false

# Bigdata.com Workflows Research Agent. Server-side only; never prefix with NEXT_PUBLIC_.
BIGDATA_API_KEY=

# FMP quote snapshot for selected US stocks, ETFs and FX pairs.
FMP_API_KEY=
FMP_DISPLAY_RIGHTS_CONFIRMED=false

# FRED: US economic release dates and published macro observations (not news articles).
FRED_API_KEY=
FRED_PUBLIC_DISPLAY_RIGHTS_CONFIRMED=false

# Local AutoPick worker. Run only with a persistent Node process and durable SQLite volume.
# In production, confirm the actual host and database are persistent before setting true.
AUTO_PICK_ENABLED=false
AUTO_PICK_RUN_SECRET=
AUTO_PICK_PERSISTENT_SERVER_CONFIRMED=false
# Thai universe comes from the server catalog (SET100 and initial mai list).
# DR universe comes from the catalog; night eligibility is checked per symbol.
AUTO_PICK_DR_ENABLED=false
# Optional U.S. pilot. Daily EOD signals only; no intraday entry/exit alerts.
AUTO_PICK_US_ENABLED=false

# Public deployment: canonical HTTPS origin must match LINE callback origin.
APP_ORIGIN=
# 64 hexadecimal characters; store a copy separately from encrypted snapshots.
BACKUP_ENCRYPTION_KEY=
BACKUP_DIRECTORY=./data/backups
