[Unit]
Description=Nugaom AI Pick web
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=nugaom
Group=nugaom
WorkingDirectory=/opt/nugaom/current
EnvironmentFile=/etc/nugaom/production.env
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=10
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/nugaom /opt/nugaom/current/.next

[Install]
WantedBy=multi-user.target
