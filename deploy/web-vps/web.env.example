# Private /etc/nugaom-workspace/web.env, root 0600. Never commit real values.
NODE_ENV=production
STORAGE_PROVIDER=d1-http
APP_ORIGIN=https://nugaom-ai-pick.nuibhr1.workers.dev
LINE_REDIRECT_URI=https://nugaom-ai-pick.nuibhr1.workers.dev/api/auth/line/callback
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
SESSION_SECRET=
PORTFOLIO_HASH_SECRET=
ADMIN_LINE_IDS=
DEMO_LOGIN_ENABLED=true
SHARED_MARKET_DATA_MODE=daily
SCANNER_RUNTIME=vps
AUTO_PICK_RUNTIME=vps
WEB_BRIDGE_URL=https://nugaom-web-data.nuibhr1.workers.dev
WEB_BRIDGE_SECRET=
VPS_ORIGIN_SECRET=
BIGDATA_API_KEY=
AI_ANALYSIS_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# Preserve Test mode until the separate payment launch checklist passes.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_ULTIMATE_MONTHLY=
# Copy only previously confirmed display rights and configured data credentials.
SETTRADE_DISPLAY_RIGHTS_CONFIRMED=true
TFEX_DISPLAY_RIGHTS_CONFIRMED=true
YAHOO_DISPLAY_RIGHTS_CONFIRMED=true
FMP_DISPLAY_RIGHTS_CONFIRMED=true
YAHOO_EOD_DISPLAY_RIGHTS_CONFIRMED=true
FOREX_MT5_ENABLED=true
FOREX_MT5_VANTAGE_SERVERS=
FOREX_MT5_DATABASE_PATH=/var/lib/nugaom/forex/bridge.sqlite
FOREX_MT5_PERSISTENT_STORAGE=true
FOREX_MT5_LOCAL_MODE=false
FOREX_MT5_MEMBER_LOCAL_FILES=false
