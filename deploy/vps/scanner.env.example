# Root-owned /etc/nugaom-scanner/scanner.env, chmod 600. Never commit values.
NODE_ENV=production
STORAGE_PROVIDER=scanner-http
SCANNER_BRIDGE_URL=https://nugaom-scanner-bridge.nuibhr1.workers.dev/v1/scanner
SCANNER_BRIDGE_SECRET=
SCANNER_INSTANCE_ID=hostinger-01
SCANNER_MARKETS=thai,dr,us,forex,tfex
SCANNER_SCHEDULE_MODE=daily
SCANNER_DAILY_HOUR_BANGKOK=7
# Keep the display-rights confirmations already approved for this project.
SETTRADE_DISPLAY_RIGHTS_CONFIRMED=true
YAHOO_DISPLAY_RIGHTS_CONFIRMED=true
# Optional native feed; copy only scanner feed credentials from the server.
BROKER_APP_ID=
BROKER_API_SECRET=
SETTRADE_BROKER_ID=
SETTRADE_APP_CODE=
SETTRADE_APP_ID=
SETTRADE_APP_SECRET=
TFEX_DISPLAY_RIGHTS_CONFIRMED=true
TFEX_BROKER_ID=
TFEX_APP_CODE=
TFEX_APP_ID=
TFEX_APP_SECRET=
