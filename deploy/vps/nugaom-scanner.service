[Unit]
Description=Nugaom portable VPS scanner (Cloudflare D1 bridge)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=nugaom-scanner
Group=nugaom-scanner
WorkingDirectory=/opt/nugaom-scanner/current
EnvironmentFile=/etc/nugaom-scanner/scanner.env
ExecStart=/usr/bin/node scanner.mjs
Restart=always
RestartSec=15
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
MemoryMax=512M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
