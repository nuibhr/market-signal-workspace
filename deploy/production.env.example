# Copy to /etc/nugaom/production.env on the VPS only; chmod 600, owner root.
# Replace YOUR_DOMAIN with the domain you own. Never commit the populated file.
APP_ORIGIN=https://YOUR_DOMAIN
LINE_REDIRECT_URI=https://YOUR_DOMAIN/api/auth/line/callback
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
ADMIN_LINE_IDS=
SESSION_SECRET=
PORTFOLIO_HASH_SECRET=
DATABASE_PATH=/var/lib/nugaom/nugaom.sqlite
BACKUP_DIRECTORY=/var/lib/nugaom/backups
BACKUP_ENCRYPTION_KEY=
AUTO_PICK_RUN_SECRET=
AUTO_PICK_PERSISTENT_SERVER_CONFIRMED=false
AUTO_PICK_ENABLED=false
AUTO_PICK_DR_ENABLED=false
AUTO_PICK_US_ENABLED=false
BROKER_APP_ID=
BROKER_API_SECRET=
SETTRADE_BROKER_ID=
SETTRADE_APP_CODE=
SETTRADE_DISPLAY_RIGHTS_CONFIRMED=false
TFEX_BROKER_ID=
TFEX_APP_CODE=
TFEX_APP_ID=
TFEX_APP_SECRET=
TFEX_DISPLAY_RIGHTS_CONFIRMED=false
FMP_API_KEY=
FMP_DISPLAY_RIGHTS_CONFIRMED=false
MARKETDX_API_KEY=
MARKETDX_PUBLIC_DISPLAY_RIGHTS_CONFIRMED=false
BIGDATA_API_KEY=
FRED_API_KEY=
FRED_PUBLIC_DISPLAY_RIGHTS_CONFIRMED=false
